{
  "name": "dsh-prompt-wall",
  "version": "0.1.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "description": "生图模板选片墙：1077 条带例图的提示词模板装进 DSH，侧栏卡片墙检索收藏，agent 工具按目标模型（qwen-image/h3-image/gpt-image/通用）自动适配提示词格式",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "data/entries.json",
    "data/thumb",
    "licenses/upstream",
    "UPSTREAMS.md",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aiohow/dsh-prompt-wall.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "prompt",
    "image-generation",
    "prompt-wall",
    "local"
  ],
  "homepage": "https://github.com/aiohow/dsh-prompt-wall#readme",
  "bugs": {
    "url": "https://github.com/aiohow/dsh-prompt-wall/issues"
  }
}
